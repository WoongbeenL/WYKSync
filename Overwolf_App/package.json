{
  "name": "wyksync-gep",
  "version": "1.0.0",
  "description": "WYKSync - Valorant live game data provider for broadcast overlays",
  "main": "dist/browser/index.js",
  "author": {
    "name": "WYKSync Team"
  },
  "license": "MIT",
  "overwolf": {
    "packages": [
      "gep"
    ]
  },
  "build": {
    "nodeGypRebuild": false,
    "appId": "com.wyksync.gep",
    "asar": true,
    "productName": "WYKSync",
    "directories": {
      "output": "build"
    },
    "files": [
      "dist/**/*",
      "overlay/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "scripts": {
    "build": "webpack --mode=development",
    "build:prod": "webpack --mode=production",
    "start": "ow-electron .",
    "build:start": "npm run build && npm run start",
    "build:ow-electron": "ow-electron-builder --publish=never"
  },
  "devDependencies": {
    "@overwolf/ow-electron": "latest",
    "@overwolf/ow-electron-builder": "latest",
    "@overwolf/ow-electron-packages-types": "^0.0.5",
    "@types/node": "^18.11.18",
    "@types/ws": "^8.5.10",
    "copy-webpack-plugin": "^11.0.0",
    "electron": "21.1.0",
    "html-webpack-plugin": "^5.5.0",
    "ts-loader": "^9.4.2",
    "typescript": "^4.7.4",
    "webpack": "^5.75.0",
    "webpack-cli": "^5.0.1"
  },
  "dependencies": {
    "ws": "^8.16.0"
  }
}